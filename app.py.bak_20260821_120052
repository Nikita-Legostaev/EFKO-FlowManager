def _step(name):
    """Пишет шаг в файл немедленно (flush) — видно даже если зависнет."""
    import datetime
    line = f"{datetime.datetime.now().strftime('%H:%M:%S.%f')[:-3]}  {name}\n"
    try:
        with open(_start_log, "a", encoding="utf-8") as f:
            f.write(line)
            f.flush()
    except Exception:
        pass

# Очищаем лог предыдущего запуска
