            self._emit("done")

        threading.Thread(target=_worker, daemon=True).start()
        return True

    def run_stage_q2(self, p):
        """Обновить Power Query 2."""
        self._stop_event.clear()

        def _worker():
            run_stage_query2(_SV(p.get("pq_file2")), self._log, self._stop_event, self._mb)
            self._emit("done")

        threading.Thread(target=_worker, daemon=True).start()
        return True

